{
  "name": "USB Webcam 1080p (Autofokus + optional manueller Fokus)",
  "meta": {
    "vendor": "Generic",
    "model": "USB Webcam 1080p (electronic focus)",
    "verified": true,
    "verifiedBy": "Andreas",
    "verifiedAt": "2026-05-30",
    "deviceNameMatch": null,
    "preferredControls": ["focus_absolute", "focus_automatic_continuous"],
    "notes": "Generischer Fallback fuer USB Webcams mit elektronischem Fokus (focus_absolute Control)."
